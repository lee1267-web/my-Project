# ─────────────────────────────────────────────────────────────
# 이 파일을 복사해서 같은 폴더에 ".env" 파일을 만들고 값을 채우세요.
#   (quiz-platform 폴더에서)  cp .env.example .env
# .env 파일은 .gitignore 에 등록되어 있어 Git 에 올라가지 않습니다.
# ─────────────────────────────────────────────────────────────

# 데이터 모드: firebase (실제 서비스) 또는 demo (이 브라우저에만 저장되는 체험 모드)
VITE_DATA_MODE=firebase

# Firebase 콘솔 > 프로젝트 설정 > 내 앱 > SDK 설정 및 구성 에서 복사하세요.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# 이미지 업로드(Firebase Storage) 사용 여부: true / false
# Storage 는 요금제(Blaze) 조건이 있을 수 있으니 README 의 "Storage 설정" 을 먼저 읽으세요.
VITE_ENABLE_STORAGE=false

# (선택) App Check reCAPTCHA v3 사이트 키. 비워두면 App Check 를 사용하지 않습니다.
VITE_RECAPTCHA_SITE_KEY=

# (개발/테스트 전용) 로컬 Firebase Emulator 에 연결할지 여부
VITE_USE_EMULATORS=false
