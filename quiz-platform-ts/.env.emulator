# "npm run dev:emulator" 전용 설정 — 로컬 Firebase Emulator 에만 연결됩니다.
# 아래 값은 실제 Firebase 프로젝트가 아닌 에뮬레이터용 가짜 값입니다. (demo- 로 시작하는 프로젝트 ID 는 에뮬레이터 전용)
VITE_DATA_MODE=firebase
VITE_USE_EMULATORS=true
VITE_FIREBASE_API_KEY=demo-api-key-emulator-only
VITE_FIREBASE_AUTH_DOMAIN=demo-quizbang.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=demo-quizbang
VITE_FIREBASE_STORAGE_BUCKET=demo-quizbang.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=000000000000
VITE_FIREBASE_APP_ID=1:000000000000:web:emulator
VITE_ENABLE_STORAGE=true
